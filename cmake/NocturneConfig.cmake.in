@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/NocturneTargets.cmake")
set(Nocturne_INSTALLED_COMPONENTS "")
foreach(_Nocturne_component IN ITEMS nocturne posix_host windows_host graph spatial simulation)
    if(TARGET Nocturne::${_Nocturne_component})
        set(Nocturne_${_Nocturne_component}_FOUND TRUE)
        list(APPEND Nocturne_INSTALLED_COMPONENTS "${_Nocturne_component}")
    else()
        set(Nocturne_${_Nocturne_component}_FOUND FALSE)
    endif()
endforeach()
unset(Nocturne_NOT_FOUND_MESSAGE)
set(_Nocturne_missing "")
foreach(_Nocturne_component IN LISTS Nocturne_FIND_COMPONENTS)
    if(Nocturne_FIND_REQUIRED_${_Nocturne_component} AND NOT Nocturne_${_Nocturne_component}_FOUND)
        list(APPEND _Nocturne_missing "${_Nocturne_component}")
    endif()
endforeach()
if(_Nocturne_missing)
    list(JOIN _Nocturne_missing ", " _Nocturne_missing)
    set(Nocturne_NOT_FOUND_MESSAGE "Required Nocturne components are unavailable: ${_Nocturne_missing}")
endif()
unset(_Nocturne_missing)
unset(_Nocturne_component)
check_required_components(Nocturne)
